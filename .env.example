# Salin menjadi .env untuk menjalankan di komputer sendiri. JANGAN commit file .env.
# Di Vercel, isi semua nilai ini lewat Project > Settings > Environment Variables.

# Wajib: kunci Gemini API (proyek dengan billing aktif bila free tier tidak tersedia)
GEMINI_API_KEY=""

# Wajib di Vercel: string acak panjang untuk menandatangani cookie pengguna dan hash IP
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_CHALLENGE_SECRET=""

# Wajib di Vercel: Upstash Redis untuk kuota dan batas laju (lokal boleh kosong, memakai memori)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Opsional: batas pemakaian dan mode pemeliharaan
GLOBAL_DAILY_LIMIT="200"
IP_HOURLY_LIMIT="40"
# Batas per pengguna: analisis teks per jam dan analisis gambar per hari.
# Saat uji fungsional TC-14/TC-12, turunkan sementara (mis. 3 dan 2) agar hemat kuota API, lalu kembalikan.
TEXT_HOURLY_LIMIT="30"
IMAGE_DAILY_LIMIT="5"
PUBLIC_ENABLED="true"

# Opsional: resolusi gambar untuk Gemini (LOW | MEDIUM | HIGH), default MEDIUM untuk hemat token
GEMINI_MEDIA_RESOLUTION="MEDIUM"

# Opsional: Cloudflare Turnstile anti-bot (aktif hanya bila keduanya diisi)
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
